// /etc/polkit-1/rules.d/50-usb-automount.rules
// Az aktív, helyi session felhasználója jelszó nélkül indíthatja/leállíthatja
// a usb-automount@sdXN.service unitokat (usb-eject ezt használja).
// Más unitra és más műveletre nem ad jogot.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units")
        return polkit.Result.NOT_HANDLED;
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (/^usb-automount@sd[a-z]+[0-9]*\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(verb) >= 0 &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
