#!/bin/bash
# usb-eject — a usb-automount által csatolt eszköz biztonságos leválasztása.
#   usb-eject              egy csatolt eszköz esetén azt, többnél választhatsz
#   usb-eject sdb1         eszköznév, /dev/sdb1 vagy mountpont is jó
#   usb-eject -a           az összes csatolt eszköz leválasztása
#   usb-eject -l           listázás
# Normál felhasználóként fut; a jogot a polkit szabály adja
# (vagy sudoers, ha nincs polkit — lásd README).
set -u
STATE_DIR=/run/usb-automount

declare -a DEVS=() MPS=()
for f in "$STATE_DIR"/sd*; do
    [[ -f $f ]] || continue
    IFS= read -r mp < "$f"
    DEVS+=("${f##*/}"); MPS+=("$mp")
done

list() {
    local i
    for i in "${!DEVS[@]}"; do printf '%2d) /dev/%-6s %s\n' $((i + 1)) "${DEVS[i]}" "${MPS[i]}"; done
}

# Egy eszköz leválasztása: 0 = sikerült
eject_one() {
    local dev=$1
    echo "Lecsatolás: /dev/$dev ..."
    systemctl stop "usb-automount@$dev.service" || return 1
    if [[ -e $STATE_DIR/$dev ]]; then
        echo "  Nem sikerült (foglalt? nézd: journalctl -u usb-automount@$dev)"
        return 1
    fi
    echo "  Kész, kihúzható."
}

if (( ${#DEVS[@]} == 0 )); then
    echo "Nincs usb-automount által csatolt eszköz."; exit 0
fi

target=""
case ${1:-} in
    -l|--list) list; exit 0 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    -a|--all)
        failed=0
        for d in "${DEVS[@]}"; do eject_one "$d" || failed=$((failed + 1)); done
        if (( failed )); then
            echo "$failed eszközt nem sikerült leválasztani."; exit 1
        fi
        echo "Mind a(z) ${#DEVS[@]} eszköz kihúzható."
        exit 0 ;;
    "")
        if (( ${#DEVS[@]} == 1 )); then
            target=${DEVS[0]}
        else
            list
            read -rp "Melyiket? [1-${#DEVS[@]}] " n
            [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#DEVS[@]} )) || { echo "Érvénytelen."; exit 1; }
            target=${DEVS[n-1]}
        fi ;;
    *)
        arg=${1%/}
        for i in "${!DEVS[@]}"; do
            if [[ $arg == "${DEVS[i]}" || $arg == "/dev/${DEVS[i]}" || $arg == "${MPS[i]}" ]]; then
                target=${DEVS[i]}
            fi
        done
        [[ -n $target ]] || { echo "Nem található: $1"; list; exit 1; } ;;
esac

eject_one "$target" || exit 1
echo "(Újracsatolás kihúzás nélkül: systemctl start usb-automount@$target)"
